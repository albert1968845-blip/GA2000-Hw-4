def t_to_rs(A, B, v0, delta_df=1e-6, h0_df=1e-4, tmax_df=1e6):
    t, x, y, vx, vy, r = integrate(1.0, 0.0, 0.0, v0,
                                   A=A, B=B,
                                   delta=delta_df, use_df=True,
                                   tmax=tmax_df, h0=h0_df, stop_at_rs=True)
    return (t[-1]*to_Myr) if (r[-1] <= r_s) else np.nan

