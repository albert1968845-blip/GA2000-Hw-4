def kepler_T(a): return 2*np.pi * (a**1.5)/np.sqrt(mu)
def init_from_rperi(r_a=1.0, r_p=r_s):
    a = 0.5*(r_a + r_p)
    v_a = np.sqrt((2.0*mu*r_p)/(r_a*(r_a + r_p)))  # tangential at apocenter
    return v_a, a

