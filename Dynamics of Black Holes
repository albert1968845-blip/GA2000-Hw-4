import numpy as np
from numpy.linalg import norm
import matplotlib.pyplot as plt


G = 1.0
M = 1.0
mu = G*M/4.0
r_s = 1e-7

# functions needed
def a_total(r, v, A=0.0, B=0.0, use_df=True):
    rr = norm(r)
    a_grav = -mu * r / (rr**3)
    if not use_df or (A==0.0 and B==0.0):
        return a_grav
    vm = norm(v)
    a_df = np.zeros(2) if vm==0 else -(A/(vm**3 + B))*v
    return a_grav + a_df

def rhs(y, A, B, use_df=True):
    x, y_, vx, vy = y
    r = np.array([x, y_]); v = np.array([vx, vy])
    a = a_total(r, v, A, B, use_df)
    return np.array([vx, vy, a[0], a[1]])

def rk4(y, h, A, B, use_df=True):
    k1 = rhs(y, A, B, use_df)
    k2 = rhs(y + 0.5*h*k1, A, B, use_df)
    k3 = rhs(y + 0.5*h*k2, A, B, use_df)
    k4 = rhs(y + h*k3, A, B, use_df)
    return y + (h/6.0)*(k1 + 2*k2 + 2*k3 + k4)

def rk4_adapt(y, t, h, A, B, delta, use_df=True, mode="pos"):
    p_up, p_dn = 2.0, 0.5
    tiny = np.nextafter(t, np.inf) - t
    h_floor = max(1e-15, 2.0*tiny)
    h_ceiling = 5e-2
    for _ in range(80):
        y_big = rk4(y, h, A, B, use_df)
        y_h   = rk4(y, 0.5*h, A, B, use_df)
        y_two = rk4(y_h, 0.5*h, A, B, use_df)
        err = float(np.max(np.abs((y_two[:2] - y_big[:2]) if mode=="pos" else (y_two - y_big))))
        if not np.isfinite(err):
            h *= p_dn
        else:
            tol = delta*abs(h)
            if err <= tol or err == 0.0:
                h_new = min(max(h*p_up, h_floor), h_ceiling)
                if t + h <= t + tiny: h = max(h, h_floor)
                return True, y_two, t + h, h_new
            h *= max(p_dn, (tol/max(err,1e-300))**0.2)
        if h <= h_floor or t + h <= t + tiny:
            raise RuntimeError(f"step size underflow at t={t:.6e}, h={h:.3e}")
    raise RuntimeError(f"adaptive step failed to converge at t={t:.6e}")


def integrate(x0, y0, vx0, vy0, A, B, delta, use_df, tmax, h0, stop_at_rs=True):
    y = np.array([x0, y0, vx0, vy0], float)
    t, h = 0.0, h0
    Ts=[t]; X=[x0]; Y=[y0]; VX=[vx0]; VY=[vy0]; R=[np.hypot(x0,y0)]
    max_steps = 2_000_000
    steps = 0
    while t < tmax and steps < max_steps:
        ok, y2, t2, h = rk4_adapt(y, t, h, A, B, delta, use_df, mode="pos")
        y, t = y2, t2                      
        r = np.hypot(y[0], y[1])
        Ts.append(t); X.append(y[0]); Y.append(y[1]); VX.append(y[2]); VY.append(y[3]); R.append(r)
        if stop_at_rs and r <= r_s: break
        if r > 10.0: break
        steps += 1
    return np.array(Ts), np.array(X), np.array(Y), np.array(VX), np.array(VY), np.array(R)

